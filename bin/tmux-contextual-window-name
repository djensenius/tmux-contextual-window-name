#!/usr/bin/env bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
ROOT_DIR="$(cd "$SCRIPT_DIR/.." && pwd)"

PYTHON_BIN="${TMUX_CONTEXTUAL_WINDOW_NAME_PYTHON:-}"
if [ -z "$PYTHON_BIN" ] && command -v tmux >/dev/null 2>&1 && [ -n "${TMUX:-}" ]; then
  PYTHON_BIN="$(tmux show-option -gqv @contextual-window-name-python-bin 2>/dev/null || true)"
fi
PYTHON_BIN="${PYTHON_BIN:-python3}"

export PYTHONPATH="$ROOT_DIR/src${PYTHONPATH:+:$PYTHONPATH}"
exec "$PYTHON_BIN" -m tmux_contextual_window_name.cli "$@"
